# ==========================================================
# Meal Booking System - Environment Configuration Template
# ==========================================================
# Copy this file to '.env' and update values to match your setup:
#   cp .env.example .env

# Flask Application Settings
FLASK_APP=run.py
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# MySQL Database Settings
# Default MySQL port is 3306. Change if your server listens on another port.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=meal_booking_db

# Database Authentication:
# Option 1: Root user (default for many local dev environments)
DB_USER=root
DB_PASSWORD=

# Option 2: Dedicated non-root user (Recommended for security)
# Run in MySQL shell:
#   CREATE USER 'meal_user'@'localhost' IDENTIFIED BY 'meal_password123';
#   GRANT ALL PRIVILEGES ON meal_booking_db.* TO 'meal_user'@'localhost';
#   FLUSH PRIVILEGES;
# Then set:
#   DB_USER=meal_user
#   DB_PASSWORD=meal_password123
